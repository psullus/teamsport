{
  "name": "teamsport",
  "version": "0.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*",
    "infra",
    "e2e"
  ],
  "scripts": {
    "ng": "ng",
    "start": "npm run start:web & npm run start:api",
    "start:web": "ng serve --port 4300",
    "start:api": "npm -w apps/api run start:dev",
    "build": "npm run build:web && npm run build:api",
    "build:web": "ng build",
    "build:api": "npm -w apps/api run build",
    "test": "npm run test:web && npm run test:api",
    "test:web": "ng test",
    "test:api": "npm -w apps/api run test",
    "test:e2e": "npm -w e2e run test",
    "sst:dev": "AWS_PROFILE=terminal npx sst dev",
    "sst:deploy": "AWS_PROFILE=terminal npx sst deploy",
    "sst:remove": "AWS_PROFILE=terminal npx sst remove"
  },
  "prettier": {
    "printWidth": 100,
    "singleQuote": true,
    "overrides": [
      {
        "files": "*.html",
        "options": {
          "parser": "angular"
        }
      }
    ]
  },
  "packageManager": "npm@10.9.4",
  "devDependencies": {
    "@swc/cli": "^0.7.10"
  }
}
